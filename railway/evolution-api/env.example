# ==============================================================================
# Evolution API v2.2.2 Environment Configuration for Railway
# ==============================================================================
# In Railway dashboard, navigate to your Evolution API Service -> Variables.
# Add the following environment variables with your production values.
#
# IMPORTANT RAILWAY VOLUME CONFIGURATION:
# In Railway dashboard, go to your Service -> Settings -> Volumes:
# Mount a Persistent Volume with Mount Path: /evolution/instances
# (This ensures WhatsApp QR credentials and Baileys sessions persist across deploys)
# ==============================================================================

# --- Server Basics ---
SERVER_TYPE=http
SERVER_PORT=8080
# The public HTTPS URL generated by Railway for your service (e.g., https://evolution-production.up.railway.app)
SERVER_URL=https://<your-evolution-service>.up.railway.app

# --- Authentication ---
# Generate a strong 32-character secret key (e.g., `openssl rand -hex 24`)
# This key is used in ERP WhatsApp Settings as the API Key
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=<generate-a-strong-random-api-key>
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# --- Database & Session Persistence (Baileys WhatsApp Auth State) ---
# Evolution API v2 stores instance states and chat history in PostgreSQL.
# Use your Supabase PostgreSQL or Railway Postgres connection string.
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_MESSAGES=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_HISTORIC=true

# --- Webhook Settings ---
# Inbound messages and session connection events are dispatched to Sunrise ERP:
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=https://<your-sunrise-erp-domain>/api/webhook/whatsapp
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_QRCODE_UPDATED=true

# --- WhatsApp Session Tuning ---
CONFIG_SESSION_PHONE_CLIENT=Sunrise Media ERP
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
