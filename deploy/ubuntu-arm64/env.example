# ==============================================================================
# Evolution API v2.2.2 Environment Configuration for Ubuntu ARM64 Cloud VM
# ==============================================================================
# Copy this file to .env on your Ubuntu server:
#   cp env.example .env
# Then fill in the values below with your production settings.
# ==============================================================================

# --- Host Port Mapping ---
# The local port on your VM where Evolution API will listen (default 8080)
HOST_PORT=8080

# --- Server URL (HTTPS Required for Production Webhooks & ERP Sharing) ---
# The public HTTPS URL where this Evolution API instance is reached.
# Use your domain name pointing to the VM with Caddy, Nginx, or Traefik reverse proxy:
SERVER_URL=https://whatsapp.yourdomain.com

# --- Authentication ---
# Set a strong 32-character API key for authenticating Sunrise ERP backend calls.
# Generate one using: openssl rand -hex 24
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=replace_with_your_secure_random_api_key_here
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# --- Database & Session Persistence (Baileys WhatsApp Auth State) ---
# Evolution API v2 stores WhatsApp credentials and chat metadata in PostgreSQL.
# Point this to your Supabase PostgreSQL or external managed PostgreSQL instance:
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_MESSAGES=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_HISTORIC=true

# --- Webhook Settings ---
# Inbound WhatsApp messages, photos, documents, and connection state updates
# will be delivered to this exact endpoint on your Sunrise ERP instance:
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=https://<your-sunrise-erp-domain>/api/webhook/whatsapp
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_QRCODE_UPDATED=true

# --- Session Customization ---
CONFIG_SESSION_PHONE_CLIENT=Sunrise Media ERP
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
